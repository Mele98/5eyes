    {"id": "desktop.external_links", "reason": "Vom Benutzer angeklickte externe Links oeffnet das Betriebssystem im Standard-Browser (shell.openExternal); Ares uebermittelt dabei keine Daten", "code_references": ["ares-desktop/main.js"]},
    {"id": "cli.scripts", "reason": "Kommandozeilen-Werkzeuge (price_updater.py als Skript, services/jurisdiction/data_pipeline.py, smoke_test.py) laufen ausserhalb des App-Prozesses ohne Laufzeitschutz; sie nutzen dieselben Marktdaten-Hosts und keine Kundendaten", "code_references": ["ares-backend/price_updater.py", "ares-backend/services/jurisdiction/data_pipeline.py", "ares-backend/smoke_test.py"]}
