{
  "schema_version": 1,
  "manifest_version": "2026-11-13.2",
  "title": "Egress-Manifest (ausgehende Verbindungen von Ares)",
  "policy": "fail_closed",
  "notice": "Jede ausgehende Verbindung des Backends muss hier einem Kanal zugeordnet sein; alles andere wird zur Laufzeit blockiert (services/egress_manifest.py). Lokale Verbindungen (localhost, 127.0.0.0/8, ::1) sind keine Uebermittlung und immer erlaubt. Kanaele mit personal_data=true laufen erst, wenn der Verantwortliche Staat und Garantie bestaetigt hat. Staaten und Garantien sind Angaben des Verantwortlichen (owner_field), Ares belegt sie nicht vor. Keine Rechtsberatung.",
  "forbidden_value_patterns": [
    "uuid",
    "email",
    "iban",
    "ahv"
  ],
  "channels": [
    {
      "id": "market_data.yfinance",
      "class": "market_data",
      "purpose": "Kurse und Kurshistorien von Indizes, ETF und Wertpapieren (Gratisquelle, Standard)",
      "personal_data": false,
      "hosts": [
        "query1.finance.yahoo.com",
        "query2.finance.yahoo.com",
        "fc.yahoo.com",
        "finance.yahoo.com"
      ],
      "allowed_fields": [
        "range",
        "interval",
        "period1",
        "period2",
        "includePrePost",
        "events",
        "crumb",
        "formatted",
        "lang",
        "region",
        "corsDomain",
        "symbols",
        "modules",
        "fields"
      ],
      "opaque_fields": [
        "crumb"
      ],
      "transmitted_data": "Ticker-Symbol, Zeitraum, Intervall; vom Anbieter ausgegebene Sitzungs-Token",
      "destination_country": {
        "owner_field": "egress.market_data.yfinance.destination_country",
        "label": "Staat des Empfaengers: Yahoo Finance",
        "kind": "country_list",
        "blocking": "informational",
        "channel": "market_data.yfinance"
      },
      "guarantee": {
        "status": "NOT_REQUIRED",
        "reason": "Keine Personendaten im Payload (Feld-Allowlist und Payload-Pruefung)"
      },
      "enforcement": "python_runtime_guard",
      "code_references": [
        "ares-backend/services/market_data/providers/yfinance_provider.py",
        "ares-backend/price_updater.py",
        "ares-backend/services/fx_rate_daily_refresh.py"
      ]
    },
    {
      "id": "market_data.yfinance_consent",
      "class": "market_data",
      "purpose": "Cookie-/Einwilligungsablauf von Yahoo, den die Bibliothek yfinance vor dem Kursabruf durchlaeuft",
      "personal_data": false,
      "hosts": [
        "guce.yahoo.com",
        "consent.yahoo.com",
        "www.yahoo.com"
      ],
      "field_policy": "screen_values_only",
      "field_policy_reason": "Formular und Weiterleitungen gibt Yahoo vor; Ares sendet hier nur die vom Anbieter ausgegebenen Werte zurueck (Sitzungs-ID, Token, Zustimmung). Feldnamen werden deshalb nicht erzwungen, Werte aber auf Personendaten-Muster geprueft (Verhaltensprobe 2026-11-11: consentUUID).",
      "allowed_fields": [
        "agree",
        "consentUUID",
        "sessionId",
        "csrfToken",
        "originalDoneUrl",
        "namespace",
        "guccounter"
      ],
      "opaque_fields": [
