        "owner_field": "egress.market_data.yfinance_consent.destination_country",
        "label": "Staat des Empfaengers: Yahoo (Einwilligungsablauf)",
        "kind": "country_list",
        "blocking": "informational",
        "channel": "market_data.yfinance_consent"
      },
      "guarantee": {
        "status": "NOT_REQUIRED",
        "reason": "Keine Personendaten im Payload (nur vom Anbieter ausgegebene Werte; Payload-Pruefung)"
      },
      "enforcement": "python_runtime_guard",
      "code_references": [
        "ares-backend/services/market_data/providers/yfinance_provider.py"
      ]
    },
