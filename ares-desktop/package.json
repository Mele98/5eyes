{
  "name": "ares-desktop",
  "productName": "Ares",
  "version": "0.4.0",
  "description": "Ares",
  "main": "main.js",
  "author": "Ares",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node tests/main.smoke.test.js && node tests/bundle-secret-scan.test.js && node --test tests/ipc-sender-guard.test.js tests/user-data-identity.test.js tests/update-egress-gate.test.js",
    "build:backend": "node scripts/build-backend.js",
    "build:reporting": "cd frontend/reporting && npm run build",
    "pack": "npm run build:reporting && npm run build:backend && npm run preflight:release && npm run scan:bundle-secrets && electron-builder --dir",
    "dist:win": "npm run build:reporting && npm run build:backend && npm run preflight:release && npm run scan:bundle-secrets && electron-builder --win nsis",
    "dist:win:portable": "npm run build:reporting && npm run build:backend && npm run preflight:release && npm run scan:bundle-secrets && electron-builder --win portable",
    "preflight:release": "node scripts/release-check.js",
    "scan:bundle-secrets": "node scripts/bundle-secret-scan.js"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ch.ares.desktop",
    "copyright": "Ares",
    "productName": "Ares",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "ipc-sender-guard.js",
      "frontend/ares.html",
      "frontend/ares.css",
      "frontend/aa-chart.css",
      "frontend/intro-sequence.js",
      "frontend/aa-chart.js",
      "frontend/ist-projection-gate.js",
      "frontend/session-boundary.js",
      "frontend/ist-projection-basis.js",
      "frontend/unsaved-changes.js",
      "frontend/goal-review-runtime.js",
      "frontend/client-compliance.js",
      "frontend/kyc-review-policy.js",
      "frontend/owner-content.js",
      "frontend/advice-contract.js",
      "frontend/privacy-governance.js",
      "frontend/sustainability-preferences.js",
      "frontend/wealth-inflows.js",
      "frontend/allocation-publication.js",
      "frontend/finalize-attestation.js",
      "frontend/fx-rates-editor.js",
      "frontend/advisor-guidance.js",
      "frontend/mandate-view.js",
      "frontend/kn3-ui.js",
      "frontend/kn4-ui.js",
      "frontend/kn5-ui.js",
      "frontend/p5c-ui.js",
      "frontend/conflict-mitigation.js",
      "frontend/eligibility-overrides.js",
      "frontend/desktop-api.js",
      "frontend/build-info.js",
      "frontend/role-ui.js",
      "frontend/trade-list-preview.js",
      "frontend/goal-analysis-integrity.js",
      "frontend/advisory-log-finma.js",
      "frontend/product-master-data.js",
      "frontend/product-evidence.js",
      "frontend/presentation-rounding.js",
      "frontend/vendor/**/*",
      "frontend/reporting/dist/**/*",
      "!frontend/reporting/dist/**/*.map",
      "!**/*.map",
      "!frontend/reporting/node_modules/**/*",
      "!frontend/reporting/src/**/*",
      "!frontend/reporting/public/**/*",
      "!frontend/reporting/*.config.*",
      "!frontend/reporting/tsconfig*.json",
      "!frontend/reporting/package*.json",
      "!frontend/reporting/README.md",
      "assets/icons/app.png",
      "update-gate.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bundle/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Ares-${version}-${arch}.${ext}",
      "icon": "assets/icons/app.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Ares",
      "uninstallDisplayName": "Ares",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "installerIcon": "assets/icons/installer-icon.ico",
      "uninstallerIcon": "assets/icons/uninstaller-icon.ico",
      "installerHeaderIcon": "assets/icons/app.ico",
      "artifactName": "Ares-Setup-${version}-${arch}.${ext}"
    },
    "asar": true,
    "beforePack": "./scripts/update-gate-before-pack.js",
    "publish": null
  },
  "desktopUpdates": {
    "enabled": false
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
