{
  "name": "5eyes-wealtharchitekten-desktop",
  "version": "0.4.0",
  "description": "Local Electron shell for the 5Eyes WealthArchitekten advisory app",
  "main": "main.js",
  "author": "OpenAI build skeleton",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node tests/main.smoke.test.js",
    "build:backend": "node scripts/build-backend.js",
    "build:reporting": "cd frontend/reporting && npm run build",
    "pack": "npm run preflight:release && npm run build:reporting && npm run build:backend && electron-builder --dir",
    "dist:win": "npm run preflight:release && npm run build:reporting && npm run build:backend && electron-builder --win nsis",
    "dist:win:portable": "npm run preflight:release && npm run build:reporting && npm run build:backend && electron-builder --win portable",
    "dist:mac": "npm run preflight:release && npm run build:reporting && npm run build:backend && electron-builder --mac dmg",
    "dist:linux": "npm run preflight:release && npm run build:reporting && npm run build:backend && electron-builder --linux AppImage",
    "preflight:release": "node scripts/release-check.js"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ch.5eyes.wealtharchitekten",
    "productName": "5Eyes WealthArchitekten",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "frontend/5eyes_v2.html",
      "frontend/desktop-api.js",
      "frontend/vendor/**/*",
      "frontend/reporting/dist/**/*",
      "!frontend/reporting/node_modules/**/*",
      "!frontend/reporting/src/**/*",
      "!frontend/reporting/public/**/*",
      "!frontend/reporting/*.config.*",
      "!frontend/reporting/tsconfig*.json",
      "!frontend/reporting/package*.json",
      "!frontend/reporting/README.md",
      "assets/icons/app.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bundle/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "5Eyes-${version}-${arch}.${ext}",
      "icon": "assets/icons/app.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "artifactName": "5Eyes-${version}-${arch}.${ext}",
      "icon": "assets/icons/app.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "artifactName": "5Eyes-${version}-${arch}.${ext}",
      "icon": "assets/icons/app.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "5Eyes WealthArchitekten",
      "uninstallDisplayName": "5Eyes WealthArchitekten",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "installerIcon": "assets/icons/installer-icon.ico",
      "uninstallerIcon": "assets/icons/uninstaller-icon.ico",
      "installerHeaderIcon": "assets/icons/app.ico",
      "artifactName": "5Eyes-Setup-${version}-${arch}.${ext}"
    },
    "asar": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.invalid/5eyes/windows"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
