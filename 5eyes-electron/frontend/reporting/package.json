{
  "name": "5eyes-reporting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "5eyes Reporting Sub-App. React + Vite + Tailwind. Konsumiert /mandates/{id}/advisory-report (Backend-Endpoint, Sprint U-P21).",
  "scripts": {
