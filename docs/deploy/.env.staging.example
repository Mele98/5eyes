# Phase-0 Staging-Env für externen Zugriff (nur synthetische Daten).
# Kopieren nach 5eyes-backend/.env und secret_key + db_key mit ECHTEN
# Zufallswerten füllen. Variablennamen = Settings-Felder (pydantic, case-insensitive).

# --- Umgebung ---
APP_ENV=staging
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Externer Zugriff / Browser-Hosting ---
SERVE_MAIN_FRONTEND=true
# Nur die echte Domain — KEIN "*", KEIN localhost (Production-Guard erzwingt das).
CORS_ORIGINS=["https://app.5eyes.ch"]

# --- Phase-0 Sicherheits-Sperre: blockiert echte Kundendaten + Banner an ---
ALLOW_REAL_CLIENT_DATA=false

# --- Tenancy (Phase-0: einzelne Demo-Tenants reichen) ---
DEPLOYMENT_TIER=tier2
TENANCY_MODE=multi
TENANT_ADMIN_UI_ENABLED=true

# --- Auth (mit `python -c "import secrets;print(secrets.token_urlsafe(48))"` erzeugen) ---
SECRET_KEY=__BITTE_ERSETZEN__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240
LOGIN_RATE_LIMIT_ENABLED=true

# --- DB (Phase-0: SQLCipher-SQLite; Postgres+RLS folgt in E1) ---
DB_PATH=/home/fiveeyes/5eyes/5eyes.db
DB_USE_SQLCIPHER=true
DB_KEY=__BITTE_ERSETZEN__
